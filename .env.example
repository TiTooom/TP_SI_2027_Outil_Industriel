# Copier ce fichier en .env puis REMPLACER tous les mots de passe.
# Pas d'apostrophe ni de guillemet dans les mots de passe (utilisés dans le script SQL d'init).

# Ports publiés sur la machine hôte (accessibles depuis le réseau local)
APP_PORT=8080
API_PORT=3000

TZ=Europe/Paris

# MariaDB
MARIADB_ROOT_PASSWORD=change-me-root

# Compte SQL de l'API (lecture seule sur les mesures)
DB_API_USER=api
DB_API_PASSWORD=change-me-api

# Compte SQL du service de relevé (ajout de mesures uniquement)
DB_POLLER_USER=poller
DB_POLLER_PASSWORD=change-me-poller

# Origine autorisée pour le CORS (vide = même origine via nginx uniquement)
CORS_ORIGIN=

# Délai max (ms) d'une lecture Modbus avant de déclarer l'automate hors ligne
# MODBUS_TIMEOUT_MS=3000
